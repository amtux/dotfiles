# Claude Code agent state
**/.claude/
!agent-skills/.claude/

# Machine-local fish config
fish/.config/fish/local.fish

# Fish universal variables — machine-specific, auto-managed by fish
fish/.config/fish/fish_variables

# Machine-local git config (identity + work routing)
git/.config/git/config.local
git/.config/git/config.work

# Pi: allow only public extension/theme resources, never agent state
/pi/.pi/*
!/pi/.pi/agent/
/pi/.pi/agent/*
!/pi/.pi/agent/extensions/
!/pi/.pi/agent/themes/
/pi/**/node_modules/
/pi/**/.env
/pi/**/.env.*
/pi/**/*.bak

# macOS
.DS_Store
